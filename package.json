{
  "name": "sistema-patrimonio",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "pnpm --dir frontend start",
    "lint": "pnpm --dir frontend lint",
    "format": "pnpm --dir frontend exec next lint --fix",
    "format:check": "pnpm --dir frontend lint"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "dompurify@<3.4.17": "3.4.17",
      "fflate@<0.8.3": "0.8.3",
      "flatted@<3.4.2": "3.4.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=9.0.0 <9.0.6": "9.0.6",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "postcss@<=8.5.22": "8.5.26",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  }
}
