{
  "name": "sistema-patrimonio",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --dir frontend build",
    "start": "pnpm --dir frontend start",
    "lint": "pnpm --dir frontend lint",
    "format": "pnpm --dir frontend exec next lint --fix",
    "format:check": "pnpm --dir frontend lint"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "dompurify@<=3.4.12": "3.4.14",
      "flatted@<3.4.2": "3.4.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "minimatch@>=9.0.0 <9.0.6": "9.0.6",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "postcss@<=8.5.22": "8.5.26",
      "sharp@<0.35.0": "0.35.4",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  }
}
